SILENT_CODE_BIN="$(command -v silent-code || echo "npx --no-install silent-code")"
zero_sha="0000000000000000000000000000000000000000"
overall=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero_sha" ]; then
    range="$(git merge-base --fork-point "$(git rev-parse --abbrev-ref HEAD@{upstream} 2>/dev/null || echo main)" "$local_sha" 2>/dev/null || echo "$local_sha")..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  $SILENT_CODE_BIN check --range "$range"
  code=$?
  if [ $code -ne 0 ]; then
    overall=$code
  fi
done

if [ $overall -ne 0 ]; then
  echo ""
  echo "silent-code: policy violation(s) found in the commits being pushed. Push blocked."
fi
exit $overall
